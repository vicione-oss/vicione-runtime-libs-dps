<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ViciOne.Suite.DataPort.Extensions</RootNamespace>
        <AssemblyName>ViciOne.Suite.DataPort.Extensions</AssemblyName>
    </PropertyGroup>

    <PropertyGroup>
        <!-- XML Documentation (generates .xml file included in package for IntelliSense) -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
      
        <!-- Include symbols and sources in main package -->
        <DebugType>portable</DebugType>
        <EmbedAllSources>true</EmbedAllSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

        <!-- Package Metadata -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>Extension library for ViciOne DataPort providing base classes, resilience, validation, queuing, and logging utilities for building incoming and outgoing data port providers.</Description>
    </PropertyGroup>

    <!-- Include documentation files in the package, preserving folder structure -->
    <ItemGroup>
        <None Include="..\..\docs\DataPort.Extensions\*.md" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="..\..\docs\DataPort.Extensions\Incoming\*.md" Pack="true" PackagePath="Incoming\" Visible="false"/>
        <None Include="..\..\docs\DataPort.Extensions\Outgoing\*.md" Pack="true" PackagePath="Outgoing\" Visible="false"/>
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataPort\DataPort.csproj" />
  </ItemGroup>

</Project>
