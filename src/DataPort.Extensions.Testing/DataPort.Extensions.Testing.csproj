<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ViciOne.Suite.DataPort.Extensions.Testing</RootNamespace>
    <AssemblyName>ViciOne.Suite.DataPort.Extensions.Testing</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- XML Documentation (generates .xml file included in package for IntelliSense) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Include symbols and sources in main package -->
    <DebugType>portable</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <!-- Package Metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Testing utilities for ViciOne DataPort.Extensions providing test helpers, fakes, and utilities for building and testing data port providers.</Description>
  </PropertyGroup>

  <!-- Include all documentation files in the package at root (flat structure) -->
  <ItemGroup>
    <None Include="..\..\docs\DataPort.Extensions.Testing\*.md" Pack="true" PackagePath="\" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataPort.Extensions.Tests"/>
    <InternalsVisibleTo Include="DataPort.Extensions.Testing.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ViciOne.TreeBuilder"/>
    <PackageReference Include="xunit.v3.extensibility.core"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataPort\DataPort.csproj"/>
    <ProjectReference Include="..\DataPort.Extensions\DataPort.Extensions.csproj"/>
  </ItemGroup>

</Project>
