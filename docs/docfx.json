{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/DataPort.Extensions",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "DataPort.Extensions/reference/api",
      "filter": "DataPort.Extensions/filterConfig.yml",
      "namespaceLayout": "nested",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "**/_site/**",
          "**/obj/**",
          "**/bin/**",
          "**/README.md",
          "**/AGENTS.md",
          "**/filterConfig.yml",
          "diagram-creation/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/*.{svg,png,jpg,jpeg,gif}"
        ],
        "exclude": [
          "_site/**",
          "**/_site/**",
          "diagram-creation/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "ViciOne DataPort",
      "_appTitle": "ViciOne DataPort",
      "_enableSearch": true,
      "_enableRightTOC": true,
      "_disableContribution": true
    },
    "validate": {
      "metadata": true,
      "links": true
    },
    "markdownEngineName": "markdig",
    "xref": [
      "https://github.com/dotnet/docfx/raw/main/.xrefmap.json"
    ],
    "serve": {
      "port": 8080
    }
  }
}
