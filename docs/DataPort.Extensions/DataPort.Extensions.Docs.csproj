<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

  <!--
    Documentation project for the DataPort.Extensions DocFX site
    (docs/DataPort.Extensions/).

    Mirrors src/DataPort.Extensions/ in the solution so the docs live next to the
    code area they describe. Like every docs project it compiles nothing and emits
    no assembly (Microsoft.Build.NoTargets), so dotnet build / dotnet test / CI
    treat it as a fast no-op. Its only job is to surface this folder's tree in the
    IDE without a hand-maintained file list — see the repo AGENTS.md
    ("Docs in the solution") for the full reasoning.

    NOTE: the markdown here is ALSO packed into the ViciOne.Suite.DataPort.Extensions
    NuGet package by src/DataPort.Extensions/DataPort.Extensions.csproj (with
    Visible="false"). That is a separate concern (packaging) from this project's
    concern (IDE visibility); the same files legitimately belong to both projects.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!--
    Surface the whole folder as None items (never compiled or copied — they just
    appear in Solution Explorer). Excluded: bin/obj, this project file, and the
    DocFX-generated, git-ignored output (_site/ and everything under reference/api/
    EXCEPT the hand-written reference/api/index.md, which is added back below).
  -->
  <ItemGroup>
    <None Include="**" Exclude="bin/**;obj/**;*.csproj;_site/**;reference/api/**" />
    <None Include="reference/api/index.md" />
  </ItemGroup>

</Project>
